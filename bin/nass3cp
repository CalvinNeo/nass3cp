#!/usr/bin/env python3
"""Run the client directly from this source tree."""

import sys
from pathlib import Path


PROJECT_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(PROJECT_ROOT / "src"))

from nass3cp.config import load_environment_file  # noqa: E402
from nass3cp.errors import Nass3cpError  # noqa: E402


client_environment = PROJECT_ROOT / "config" / "client.env"
if client_environment.is_file():
    try:
        load_environment_file(str(client_environment))
    except Nass3cpError as exc:
        print("nass3cp: %s" % exc, file=sys.stderr)
        raise SystemExit(1)

from nass3cp.cli import main  # noqa: E402


main()
