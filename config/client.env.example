# On Windows, prefer --remember-password and Windows Credential Manager.
# For unattended or non-Windows use, copy this file to config/client.env and uncomment:
# NASS3CP_PASSWORD=replace-with-the-same-password-as-the-server

# Browser file downloads: 1-8 simultaneous files (default: 1).
# --download-concurrency overrides this setting.
# NASS3CP_DOWNLOAD_CONCURRENCY=1
